{
  "name": "axon-llmrouter",
  "version": "1.0.0",
  "description": "SDK-based multi-tier LLM router (Frontier, Balanced, Fast) with Gate + Judge inference.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imayushsawant/Axon.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/imayushsawant/Axon/issues"
  },
  "homepage": "https://github.com/imayushsawant/Axon#readme",
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@tanstack/ai": "^0.53.0",
    "@tanstack/ai-anthropic": "^0.18.5",
    "@tanstack/ai-gemini": "^0.29.1",
    "@tanstack/ai-openai": "^0.22.5"
  }
}
