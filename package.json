{
  "name": "axon-llmrouter",
  "version": "0.1.1",
  "description": "SDK-based multi-tier LLM router (Frontier, Balanced, Fast) with Gate + Judge inference.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p eval/tsconfig.json",
    "test": "tsx --test eval/harness.test.ts",
    "eval": "tsx eval/run.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imayushsawant/Axon.git"
  },
  "keywords": [
    "llm",
    "router",
    "openai",
    "anthropic",
    "gemini",
    "sdk"
  ],
  "author": "Ayush Sawant",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/imayushsawant/Axon/issues"
  },
  "homepage": "https://github.com/imayushsawant/Axon#readme",
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@tanstack/ai": "^0.53.0",
    "@tanstack/ai-anthropic": "^0.18.5",
    "@tanstack/ai-gemini": "^0.29.1",
    "@tanstack/ai-openai": "^0.22.5"
  }
}
