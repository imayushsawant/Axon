# Judge is required for classify() eval. Frontier/Balanced keys are unused by the harness.
#
# Native OpenAI / Anthropic / Gemini: model id only (no baseURL).
#   AXON_JUDGE_MODEL=gemini-2.5-flash
#   AXON_JUDGE_MODEL=gpt-4o
#
# OpenAI-compatible host (Groq, OpenRouter, Together, …): set *_BASE_URL and use the
# host catalog id as-is, including openai/ if the host lists it that way.
#   AXON_JUDGE_MODEL=openai/gpt-oss-120b
#   AXON_JUDGE_BASE_URL=https://api.groq.com/openai/v1
# A non-empty BASE_URL routes gpt-* / openai/... through that host, not api.openai.com.
# Each of Judge / Frontier / Balanced / Fast has its own BASE_URL.
AXON_JUDGE_MODEL=gemini-2.5-flash
AXON_JUDGE_API_KEY=
# AXON_JUDGE_BASE_URL=

# Optional placeholders (classify() does not call these models)
# AXON_FRONTIER_MODEL=gpt-5
# AXON_FRONTIER_API_KEY=unused
# AXON_FRONTIER_BASE_URL=
# AXON_BALANCED_MODEL=claude-sonnet-4-5
# AXON_BALANCED_API_KEY=unused
# AXON_BALANCED_BASE_URL=
# AXON_FAST_MODEL=claude-haiku-4-5
# AXON_FAST_API_KEY=
# AXON_FAST_BASE_URL=
# AXON_FALLBACK_TIER=balanced
